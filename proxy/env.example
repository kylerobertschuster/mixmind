# MixMind Proxy — environment variables
# Copy this to .env and fill in your key

DEEPSEEK_API_KEY=your_deepseek_key_here
ADMIN_SECRET=choose_a_strong_secret_here
PORT=3000
LICENSES_FILE=./licenses.json

# Plugin-side configuration (set these when launching your DAW):
# export MIXMIND_SERVER_URL=http://localhost:3000
# export MIXMIND_LICENSE_KEY=MM-XXXXXXXXXXXXXXX
